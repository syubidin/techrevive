# Salin ke .env.local. JANGAN commit file .env*.
DATABASE_URL="postgresql://user:pass@host:5432/techrevive?sslmode=require"
DIRECT_URL="postgresql://user:pass@host:5432/techrevive?sslmode=require"

# Buat dengan: openssl rand -base64 48
SESSION_SECRET=""
IP_HASH_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Placeholder, ganti dengan nomor WA bisnis asli (format 628xxxxxxxxxx)
WHATSAPP_NUMBER="6281200000000"

# Cloudflare Turnstile (wajib di production)
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Opsional: rate limit konsisten antar instance
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Host gambar (R2 / CDN), tanpa https://
IMAGE_HOST=""

# Set 1 hanya jika situs di belakang Cloudflare proxy
TRUST_CLOUDFLARE=""

# Notifikasi inquiry baru (isi salah satu atau keduanya; kosong = nonaktif)
# Telegram: buat bot via @BotFather, kirim pesan ke bot, ambil chat id dari getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Webhook generik (Slack/Discord/n8n): menerima POST JSON {"text": "..."}
NOTIFY_WEBHOOK_URL=""

# Rahasia untuk pekerjaan terjadwal (min. 24 karakter). Buat: openssl rand -base64 32
CRON_SECRET=""

# Cloudflare R2 (unggah foto produk). Kosong = unggah dinonaktifkan, URL manual tetap bisa dipakai.
# Alternatif gratis TANPA kartu kredit: Cloudinary (isi IMAGE_HOST="res.cloudinary.com")
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
