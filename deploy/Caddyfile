{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip
	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent
	# Header keamanan lain (CSP, HSTS) diset oleh aplikasi.
	request_body { max_size 1MB }
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up -Cf-Connecting-Ip
	}
}
